<Project>
  <!-- Centralized version management for all projects -->
  <PropertyGroup>
    <Version>11.13.0</Version>
    <PackageReleaseNotes>Aligned 11.13.0 toolkit release accompanying SIP call control: hold/resume, in-dialog media refresh, blind and attended REFER transfer, caller and diversion identities. SIP core and adapter are published separately at the same version, with retained SRTP replay windows and REFER subscription correlation verified on Windows and Linux.</PackageReleaseNotes>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    
    <!-- Common package metadata -->
    <Authors>TLBX</Authors>    
    <Product>AI Voice Assistant Toolkit</Product>
    <Copyright>Copyright © 2025 TLBX</Copyright>
    
    <!-- Package settings -->
    <PackageProjectUrl>https://github.com/AiTlbx/Ai.Tlbx.VoiceAssistant</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AiTlbx/Ai.Tlbx.VoiceAssistant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>AI;Voice;Assistant;OpenAI;Realtime;Audio;Speech</PackageTags>
    
    <!-- Build settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Existing settings -->
    <NuGetAudit>false</NuGetAudit>
    <NoLogo>true</NoLogo>
  </PropertyGroup>
</Project>
