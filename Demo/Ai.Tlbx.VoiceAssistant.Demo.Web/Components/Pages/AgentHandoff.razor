@page "/agent-handoff"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System
@using System.Linq
@using System.Collections.Generic
@using Ai.Tlbx.VoiceAssistant.Provider.OpenAi.AspNetCore
@using Ai.Tlbx.VoiceAssistant.Provider.OpenAi.Models
@using Ai.Tlbx.VoiceAssistant.Models
@using Ai.Tlbx.VoiceAssistant.Managers
@using Ai.Tlbx.VoiceAssistant.BuiltInTools
@using Ai.Tlbx.VoiceAssistant.Demo.Web.Tools
@using Ai.Tlbx.VoiceAssistant.Demo.Web.Services
@inject OpenAiDirectLiveVoiceProvider Live
@inject InferenceHandoffBackend Backend

<PageTitle>Agent-Handoff · Voice Assistant</PageTitle>
<section class="handoff-page">
<a href="/">← Alle Provider</a>
<h1>Sprich weiter. Der Agent arbeitet.</h1>
<p>GPT-Live führt das Gespräch. GPT-6.1 Sol bearbeitet mehrstufige Aufgaben mit Ai.Tlbx.Inference und behält vollständige Dokumente und Ergebnisse.</p>
<div class="mb-3">
    <label for="handoff-model">Sprachmodell · API-Modell-ID</label>
    <input id="handoff-model" @bind="model" disabled="@busy" class="form-control" autocomplete="off" />
    <p class="text-muted">Stand 17.10.2026: Der API-Modellkatalog dieses Kontos führt GPT-Live 1. GPT-Live 1.1 und Quip sind für diese API noch nicht bestätigt. Es gibt keinen automatischen Modellwechsel.</p>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    <button id="handoff-start" class="btn btn-primary" @onclick="Start" disabled="@busy">Gespräch starten</button>
    <button id="handoff-stop" class="btn btn-outline-secondary" @onclick="Stop" disabled="@(!connected)">Beenden</button>
    <button id="handoff-cancel" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@(!connected)">Agent-Aufträge abbrechen</button>
</div>
<p id="handoff-status" role="status">@status</p>
<p>Beispiel: „Prüfe die große Projektakte. Welche Mängel verhindern die Freigabe, welcher Code steht am Ende, und wie würdest du die nächsten Schritte priorisieren?“ Danach kannst du Rückfragen stellen.</p>
<p class="text-muted">Die Demo verwendet synthetische Unterlagen und lokale Beispieltools. Beenden schließt die kostenpflichtige Sprachsitzung. Abbrechen stoppt ausstehende Agent-Fortsetzungen; ein bereits laufendes Tool kann noch fertig werden.</p>
<p id="handoff-usage">Sprachzeit: @ledger.TotalSessionDuration.TotalSeconds.ToString("F1") s · Agent-Tokens: @ledger.TotalTokens · bekannte Modellkosten: $@cost.ToString("F5") @(partial ? "(unvollständige Schätzung)" : "(Schätzung)") · finale Sprach-Usage: @(Live.FinalUsageConfirmed ? "bestätigt" : "offen")</p>
<h2>Agent-Aktivität</h2>
<ul id="handoff-activity">@foreach (var item in activity) { <li>@item</li> }</ul>
<h2>Gespräch</h2>
<p id="handoff-user">@userText</p>
<p id="handoff-assistant">@assistantText</p>
<h2>Vollständiges Arbeitsergebnis</h2>
<pre id="handoff-result" style="white-space:pre-wrap">@resultText</pre>
</section>

@code {
    private string model = "gpt-live-1", status = "Bereit", userText = "", assistantText = "", resultText = "";
    private bool busy, connected, disposed;
    private readonly UsageManager ledger = new();
    private readonly List<string> activity = new();
    private decimal cost;
    private bool partial;
    protected override void OnInitialized()
    {
        Live.OnStatusChanged = s => Update(() => status = s);
        Live.OnError = e => Update(() => status = "Fehler: " + e);
        Live.OnTranscriptDelta = d => Update(() => { if (d.Role == "user") userText += d.Delta; else assistantText += d.Delta; });
        Live.OnBackendActivity = a => Update(() => {
            activity.Add($"{a.DelegationId}: {a.State}{(a.Detail == null ? "" : " · " + a.Detail)}");
            if (activity.Count > 60) activity.RemoveAt(0);
        });
        Live.OnUsageReceived = u => Update(() => {
            ledger.AddReport(u);
            var estimates = ledger.GetReports().Select(r => VoiceCostCalculator.Estimate(r, VoiceCostCalculator.GetRates(r))).ToArray();
            cost = estimates.Sum(e => e.KnownCostUsd);
            partial = estimates.Any(e => !e.IsComplete);
        });
        Backend.OnResult = r => Update(() => resultText = r);
    }
    private void Update(Action change)
    {
        if (!disposed) _ = InvokeAsync(() => { change(); StateHasChanged(); });
    }
    private async Task Start()
    {
        busy = true;
        status = "Verbindung wird aufgebaut";
        ledger.ClearReports(); activity.Clear(); cost = 0; partial = false;
        userText = assistantText = resultText = "";
        try
        {
            await Live.StartBrowserSessionAsync(new OpenAiLiveSettings {
                ModelId = model, Voice = "marin",
                Instructions = "Sprich natürlich und knapp Deutsch. Sage zu Beginn, dass du ein KI-Assistent bist. " +
                    "Delegiere Analysen, Berechnungen und Dokumentaufgaben an den Agenten. Du kannst weiter zuhören und Rückfragen beantworten, während er arbeitet. " +
                    "Behaupte keine Ergebnisse bevor der Agent sie meldet. Die Tools verwenden synthetische Demo-Daten.",
                ClientBackend = new() { Handler = Backend.RunAsync, Timeout = TimeSpan.FromMinutes(5) },
                Tools = new() { new TimeTool(), new CalculatorTool(), new LargeCatalogTool(), new LargeDossierTool() }
            });
            connected = true;
            await Live.AppendInstructionsAsync("Begrüße den Nutzer kurz und frage nach seiner Aufgabe.");
        }
        catch (Exception ex) { status = "Start fehlgeschlagen: " + ex.Message; await Live.DisconnectAsync(); busy = connected = false; }
    }
    private void Cancel() => Live.CancelClientBackend();
    private async Task Stop()
    {
        try { await Live.DisconnectAsync(); status = "Beendet"; }
        catch (Exception ex) { status = "Fehler beim Beenden: " + ex.Message; }
        finally { busy = connected = false; }
    }
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Backend.OnResult = null;
        await Live.DisposeAsync();
    }
}
